                        )

                        if price is not None:

                            break

                    except Exception:

                        continue

                # =================================================
                # RATING
                # =================================================

                rating = None

                for selector in [

                    "#acrPopover",

                    "span[data-hook='rating-out-of-text']",

                    "#averageCustomerReviews "
                    ".a-icon-alt"

                ]:

                    try:

                        element = page.locator(
