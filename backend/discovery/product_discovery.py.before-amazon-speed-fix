    # ========================================================
    # AMAZON DETAILS CHECK
    # ========================================================

    def _amazon_details_missing(
        self,
        product
    ):

        if not product:

            return True

        important_fields = [

            product.get("brand"),
            product.get("price"),
            product.get("rating"),
            product.get("review_count")

        ]

        missing_count = sum(
            1
            for value in important_fields
            if value is None
        )

        return missing_count >= 2

